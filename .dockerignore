# Der Build-Kontext geht komplett zu Fly hoch - alles hier draussen ist Uploadzeit.
.git/
.gradle/
# Beide Dockerfiles (Root + keycloak-extension) kopieren nur noch fertige Artefakte aus
# build/podman (siehe stagePodmanArtifacts in build.gradle.kts) - alles andere unter build/
# (Klassen, Test-Reports, Gradle-Zwischenstaende) bleibt draussen.
build/*
!build/podman
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
# Die lokale H2-Datei. Sie im Image zu haben waere nicht nur unnoetig, sondern falsch:
# in Produktion liegt die DB auf dem gemounteten Volume.
data/
.beads/
.opencode/
.idea/
.vscode/
.kotlin/
docs/
*.md
!frontend/README.md
.DS_Store
