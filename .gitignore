# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Java
*.class
*.jar
*.war
*.ear
# Muss NACH *.jar stehen: in .gitignore gewinnt die spaetere Regel, und als Ausnahme weiter
# oben war sie wirkungslos - der Wrapper fehlte im Repo und jeder Checkout ohne lokale Kopie
# (CI, Docker-Build) scheiterte an "Unable to access jarfile".
!gradle/wrapper/gradle-wrapper.jar

# H2 database files
*.mv.db
*.trace.db
data/

# Frontend build output (generated by npm run build)
src/main/resources/static/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Local environment
.env
.env.local

# OpenCode workspace metadata
.opencode/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Playwright e2e artifacts
test-results/
playwright-report/
